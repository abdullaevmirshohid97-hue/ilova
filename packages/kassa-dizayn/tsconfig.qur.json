{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist/turlar",
    "outDir": "dist/turlar",

    "noEmitOnError": false
  },
  "include": ["index.tsx"]
}
