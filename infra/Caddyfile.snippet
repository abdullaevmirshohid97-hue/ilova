# Yukchibolla — bu VPS'dagi UMUMIY /etc/caddy/Caddyfile'ga QO'LDA qo'shiladigan
# bloklar (Clary va Luxury Textile bloklarini o'chirmang/o'zgartirmang!).
#
# Qo'shishdan oldin: cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak-$(date +%F)
# Qo'shgandan keyin:  caddy validate --config /etc/caddy/Caddyfile
#                      systemctl restart caddy   (reload emas!)
#
# Caddy avtomatik Let's Encrypt SSL oladi — certbot kerak emas, faqat DNS
# A-record uchta subdomen uchun shu VPS IP'siga to'g'ri kelishi kifoya.

admin.yukchibolla.com, 4020.yukchibolla.com {
	root * /var/www/ilova-admin/dist

	# zstd gzip'dan ~15% yaxshiroq siqadi; qo'llab-quvvatlamaydigan
	# brauzerlar avtomatik gzip'ga tushadi
	encode zstd gzip

	# Fayl nomida hash bor (index-xZwHXtpi.js) — mazmuni o'zgarsa nom ham
	# o'zgaradi, shuning uchun bir yil keshlash xavfsiz
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# index.html HECH QACHON keshlanmasin — aks holda yangi deploy'dan keyin
	# brauzer eski HTML'ni ko'rsatib, allaqachon yo'q bo'lgan eski asset
	# fayllarini so'rab oq ekran beradi
	@html path /index.html /
	header @html Cache-Control "no-cache, must-revalidate"

	# Telegram Mini App sahifasi: manzili o'zgarmaydi (klaviatura tugmasi
	# chatda saqlanadi), shuning uchun yangilik faqat shu sarlavha orqali
	# yetadi. Keshlansa - mijoz eski sahifani ko'radi va "ro'yxat
	# ko'rinmayapti" deb qoladi.
	@miniapp path /dori-miniapp.html
	header @miniapp Cache-Control "no-store, must-revalidate"

	try_files {path} /index.html
	file_server
}

app.yukchibolla.com {
	root * /var/www/ilova-app-landing
	encode zstd gzip

	@assets path /_expo/* /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@html path /index.html /
	header @html Cache-Control "no-cache, must-revalidate"

	# APK to'g'ridan-to'g'ri yuklab olinsin (SPA fallback'ga tushmasin)
	@apk path /yukchibolla.apk
	header @apk Content-Disposition "attachment; filename=yukchibolla.apk"

	# Expo web ham SPA — ichki sahifa yangilanganda 404 bo'lmasligi uchun
	try_files {path} /index.html
	file_server
}
