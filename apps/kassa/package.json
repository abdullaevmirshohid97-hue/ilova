{
  "name": "@ilova/kassa",
  "version": "1.0.0",
  "description": "Clary — Credit · Debit · Money Flow (Android + web)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "expo export --platform web --clear",
    "build:apk": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "logo": "node ../../scripts/clary-ikonka-yasa.mjs assets/manba-ikonka.png",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@ilova/kassa-yadro": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.49.0",
    "expo": "~54.0.35",
    "expo-clipboard": "~8.0.8",
    "expo-contacts": "~15.0.11",
    "expo-file-system": "~19.0.24",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
