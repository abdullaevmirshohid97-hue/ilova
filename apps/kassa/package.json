{
  "name": "@ilova/kassa",
  "version": "1.0.0",
  "description": "Credit Debit — hisob-kitob daftari (Android + web)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "build:web": "expo export --platform web --clear",
    "build:apk": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "logo": "node ../../scripts/credit-debit-logo.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ilova/kassa-yadro": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.49.0",
    "expo": "~54.0.35",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
