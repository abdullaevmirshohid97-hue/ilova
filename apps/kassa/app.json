{
  "expo": {
    "name": "Clary",
    "slug": "credit-debit",
    "scheme": "creditdebit",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#013a26"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.yukchibolla.creditdebit"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#013a26"
      },
      "package": "uz.yukchibolla.creditdebit",
      "versionCode": 14,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "_izoh": "Web versiya app.yukchibolla.com/kassa/ ostida turadi. baseUrl busiz bundle /_expo/... dan qidiriladi va sahifa oq ochiladi.",
      "baseUrl": "/kassa"
    },
    "extra": {
      "izoh": "Tenant yo'nalishi: kassa. Baza — gnuddryjsmcrjchrbvyz, jadvallar kassa_*",
      "eas": {
        "projectId": "2054e626-26b6-414a-aa2b-a8e4c2b7a249"
      }
    },
    "owner": "amirxon.ai4020",
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mijoz rasmini qo‘yish uchun galereyaga ruxsat kerak."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Mijoz manzilini shu yerdan turib belgilash uchun joylashuv kerak."
        }
      ]
    ]
  }
}
